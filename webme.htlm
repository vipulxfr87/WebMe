cl<!DOCTYPE html> 

<html lang="en"> 

<head> 

  <meta charset="UTF-8" /> 

  <title>Dev's Webpage</title> 

  <style> 

    body { 

      margin: 0; 

      height: 100vh; 

      font-family: Arial, Helvetica, sans-serif; 

      background: linear-gradient(135deg, #ff9a9e, #fad0c4, #a18cd1, #fbc2eb); 

      display: flex; 

      align-items: center; 

      justify-content: center; 

    } 

  

    .card { 

      background: rgba(255, 255, 255, 0.9); 

      padding: 40px 60px; 

      border-radius: 20px; 

      box-shadow: 0 15px 30px rgba(0, 0, 0, 0.2); 

      text-align: center; 

      border: 2px solid #ffffff; 

    } 

  

    h1 { 

      margin: 0 0 10px; 

      font-size: 2rem; 

      color: #333; 

    } 

  

    p { 

      margin: 0; 

      font-size: 1.2rem; 

      color: #555; 

    } 

  

    .highlight { 

      color: #ff5e62; 

      font-weight: bold; 

    } 

  </style> 

</head> 

<body> 

  <div class="card"> 

    <h1>Welcome!</h1> 

    <p><span class="highlight">This is my webpage created by dev</span></p> 

  </div> 

</body> 

</html> 
 

